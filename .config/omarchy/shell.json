{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "id": "techmessiah.bar",
    "layout": {
      "center": [
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "techmessiah.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "techmessiah.audio"
        },
        {
          "id": "techmessiah.network"
        },
        {
          "id": "techmessiah.bluetooth"
        },
        {
          "id": "techmessiah.power"
        },
        {
          "id": "techmessiah.control-center"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "cloneSourceRestores": [
    "techmessiah.notifications",
    "techmessiah.lock",
    "techmessiah.osd"
  ],
  "disabledPlugins": [
    "omarchy.notifications",
    "omarchy.lock",
    "omarchy.osd"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "techmessiah.notifications"
    },
    {
      "id": "techmessiah.lock"
    },
    {
      "id": "techmessiah.osd"
    }
  ],
  "version": 1
}
